diff --git a/Shirox/Services/BangumiService.swift b/Shirox/Services/BangumiService.swift
new file mode 100644
index 0000000..4f67e1a
--- /dev/null
+++ b/Shirox/Services/BangumiService.swift
@@ -0,0 +1,389 @@
+import Foundation
+
+/// Bangumi (bgm.tv) anime metadata, read natively from its public v0 API.
+///
+/// Built into the app beside AniList and MyAnimeList as a Home and Search source. Like Simkl it is
+/// kept out of `ProviderManager`'s chain: Bangumi subject ids are not AniList or MyAnimeList ids,
+/// so its titles open their own page and are never sent to a tracker. No account is needed.
+@MainActor
+final class BangumiService {
+    static let shared = BangumiService()
+
+    nonisolated static let apiBase = "https://api.bgm.tv/v0"
+    nonisolated static let siteBase = "https://bgm.tv"
+    /// Bangumi asks API clients for an identifying User-Agent.
+    nonisolated static let userAgent = "quiteQa/ShiroxBangumi/0.4.0 (https://github.com/quiteQa/shirox-bangumi)"
+    nonisolated static let pageSize = 25
+
+    private let session: URLSession
+
+    init(session: URLSession = .shared) {
+        self.session = session
+    }
+
+    // MARK: - Reads
+
+    func search(_ keyword: String) async throws -> [ModuleMetadata] {
+        let keyword = keyword.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !keyword.isEmpty else { return [] }
+        if let id = Self.subjectID(in: keyword) { return [try await subject(id: id)] }
+        let body: [String: Any] = [
+            "keyword": keyword,
+            "sort": "match",
+            "filter": ["type": [2], "nsfw": false]
+        ]
+        let page: BangumiPage<BangumiSubject> = try await request(
+            "/search/subjects", query: ["limit": "\(Self.pageSize)", "offset": "0"],
+            method: "POST", body: try JSONSerialization.data(withJSONObject: body))
+        return Self.unique(page.data.filter(\.isAnime).compactMap(Self.metadata))
+    }
+
+    func subject(id: Int) async throws -> ModuleMetadata {
+        guard id > 0 else { throw ProviderError.notFound }
+        let subject: BangumiSubject = try await request("/subjects/\(id)")
+        guard subject.isAnime, let record = Self.metadata(subject) else { throw ProviderError.notFound }
+        return record
+    }
+
+    /// Ranked or premiere-date catalogs, 25 to a page; pages start at 1.
+    func browse(_ catalog: ModuleMetadataCatalog, page: Int = 1) async throws -> [ModuleMetadata] {
+        let sort = catalog == .topRated ? "rank" : "date"
+        let offset = max(0, page - 1) * Self.pageSize
+        let result: BangumiPage<BangumiSubject> = try await request(
+            "/subjects", query: ["type": "2", "sort": sort, "limit": "\(Self.pageSize)", "offset": "\(offset)"])
+        return Self.unique(result.data.filter(\.isAnime).compactMap(Self.metadata))
+    }
+
+    /// Main episodes only (Bangumi type 0), in broadcast order.
+    func episodes(subjectID: Int) async throws -> [ModuleEpisodeMetadata] {
+        guard subjectID > 0 else { throw ProviderError.notFound }
+        var rows: [BangumiEpisode] = []
+        var seen = Set<Int>()
+        var offset = 0
+        // 50 pages of 200 covers the longest-running series while bounding broken pagination.
+        for _ in 0..<50 {
+            let page: BangumiPage<BangumiEpisode> = try await request(
+                "/episodes", query: ["subject_id": "\(subjectID)", "type": "0", "limit": "200", "offset": "\(offset)"])
+            let fresh = page.data.filter { seen.insert($0.id).inserted }
+            rows += fresh
+            offset += page.data.count
+            if page.data.isEmpty || fresh.isEmpty { break }
+            if let total = page.total, offset >= total { break }
+            if page.total == nil, page.data.count < 200 { break }
+        }
+        return rows
+            .filter { $0.type == 0 && ($0.subjectID == nil || $0.subjectID == subjectID) }
+            .compactMap { Self.episode($0, subjectID: subjectID) }
+            .sorted { $0.number == $1.number ? $0.id < $1.id : $0.number < $1.number }
+    }
+
+    // MARK: - Media
+
+    /// A Bangumi title as the app's `Media`: keyed `bangumi-<subject id>`, with no tracker ids.
+    nonisolated static func media(_ record: ModuleMetadata) -> Media {
+        Media(
+            id: record.id, idMal: nil, provider: .bangumi,
+            title: MediaTitle(romaji: nil, english: record.title, native: record.titles.original),
+            coverImage: MediaCoverImage(large: record.poster, extraLarge: record.poster), bannerImage: nil,
+            description: record.description, episodes: record.episodeCount, status: nil,
+            averageScore: record.rating.scoreOutOf100, genres: nil, season: nil, seasonYear: record.year,
+            nextAiringEpisode: nil, relations: nil, type: "ANIME", format: record.format)
+    }
+
+    // MARK: - Parsing
+
+    /// `400602`, `bgm:400602`, `subject:400602` or a bgm.tv / bangumi.tv / chii.in subject link.
+    nonisolated static func subjectID(in text: String) -> Int? {
+        let text = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        let patterns = [
+            #"^https?://(?:www\.)?(?:bgm\.tv|bangumi\.tv|chii\.in)/subject/([1-9][0-9]{0,9})/?(?:[?#].*)?$"#,
+            #"^(?:bgm|subject):([1-9][0-9]{0,9})$"#
+        ]
+        for pattern in patterns {
+            guard let regex = try? NSRegularExpression(pattern: pattern, options: [.caseInsensitive]),
+                  let match = regex.firstMatch(in: text, range: NSRange(text.startIndex..., in: text)),
+                  let range = Range(match.range(at: 1), in: text) else { continue }
+            return Int(text[range])
+        }
+        return nil
+    }
+
+    nonisolated static func metadata(_ item: BangumiSubject) -> ModuleMetadata? {
+        guard item.id > 0 else { return nil }
+        let chinese = clean(item.nameCN)
+        let original = clean(item.name)
+        let images = item.images
+        let poster = clean(images?.large) ?? clean(images?.common) ?? clean(images?.medium)
+            ?? clean(images?.small) ?? clean(item.image)
+        let releaseDate = date(item.date)
+        let rawScore = item.rating?.score ?? item.score
