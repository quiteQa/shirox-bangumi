diff --git a/Shirox/Models/ModuleMetadata.swift b/Shirox/Models/ModuleMetadata.swift
new file mode 100644
--- /dev/null
+++ b/Shirox/Models/ModuleMetadata.swift
@@ -0,0 +1,88 @@
+import Foundation
+
+struct ModuleMetadataIdentity: Codable, Equatable, Hashable, Sendable {
+    let moduleID: String
+    let source: String
+    let subjectID: Int
+}
+
+/// The v1 metadata contract. Optional fields remain unknown rather than inferred.
+struct ModuleMetadata: Codable, Sendable {
+    struct Titles: Codable, Sendable {
+        let chinese: String?
+        let original: String?
+    }
+
+    struct Rating: Codable, Sendable {
+        let score: Double?
+        let scale: Int
+        let rank: Int?
+        let votes: Int?
+
+        var scoreOutOf100: Int? {
+            guard scale == 10, let score, score.isFinite, score > 0, score <= 10 else { return nil }
+            return Int((score * 10).rounded())
+        }
+    }
+
+    let schemaVersion: Int
+    let source: String
+    let id: Int
+    let url: String
+    let title: String
+    let titles: Titles
+    let aliases: [String]
+    let description: String
+    let poster: String?
+    let format: String?
+    let releaseDate: String?
+    let year: Int?
+    let episodeCount: Int?
+    let totalEpisodes: Int?
+    let tags: [String]
+    let studios: [String]
+    let directors: [String]
+    let rating: Rating
+
+    var isValid: Bool {
+        schemaVersion == 1 && id > 0 && !source.isEmpty && !title.isEmpty && rating.scale == 10
+    }
+
+    func media(moduleID: String) -> Media {
+        let key = "metadata|\(moduleID)|\(source)|\(id)"
+        var result = Media(
+            id: Media.localId(forKey: key), idMal: nil, provider: .local,
+            title: MediaTitle(romaji: nil, english: title, native: titles.original),
+            coverImage: MediaCoverImage(large: poster, extraLarge: poster), bannerImage: nil,
+            description: description, episodes: episodeCount, status: nil,
+            averageScore: rating.scoreOutOf100, genres: nil, season: nil, seasonYear: year,
+            nextAiringEpisode: nil, relations: nil, type: "ANIME", format: format)
+        result.moduleMetadata = ModuleMetadataIdentity(moduleID: moduleID, source: source, subjectID: id)
+        return result
+    }
+}
+
+struct ModuleEpisodeMetadata: Decodable, Identifiable, Sendable {
+    let id: Int
+    let subjectId: Int
+    let number: Double
+    let episodeNumber: Double?
+    let title: String
+    let originalTitle: String?
+    let description: String
+    let airdate: String?
+    let duration: String?
+    let durationSeconds: Int?
+    let url: String
+}
+
+enum ModuleMetadataCatalog: String, CaseIterable, Identifiable {
+    case topRated, newest
+    var id: String { rawValue }
+    var title: String {
+        switch self {
+        case .topRated: return String(localized: "shared.top_rated")
+        case .newest: return String(localized: "modules.metadata_newest")
+        }
+    }
+}
diff --git a/Shirox/Services/ModuleMetadataService.swift b/Shirox/Services/ModuleMetadataService.swift
new file mode 100644
--- /dev/null
+++ b/Shirox/Services/ModuleMetadataService.swift
@@ -0,0 +1,53 @@
+import Foundation
+
+/// A separate runner prevents reading metadata from replacing the playback module's JS.
+@MainActor
+final class ModuleMetadataService {
+    private let module: ModuleDefinition
+    private let runner = ModuleJSRunner()
+    private var loaded = false
+
+    init(module: ModuleDefinition) { self.module = module }
+
+    private func prepare() async throws {
+        guard module.isMetadata else { throw ProviderError.unsupported }
+        if !loaded {
+            try await runner.load(module: module)
+            loaded = true
+        }
+    }
+
+    func search(_ keyword: String) async throws -> [ModuleMetadata] {
+        try await prepare()
+        let result: [ModuleMetadata] = try await runner.readMetadata("searchMetadata", args: [keyword])
+        return try validated(result)
+    }
+
+    func detail(id: Int) async throws -> ModuleMetadata {
+        try await prepare()
+        let result: ModuleMetadata = try await runner.readMetadata("extractMetadata", args: [id])
+        guard result.isValid, result.id == id else { throw ProviderError.notFound }
+        return result
+    }
+
+    func episodes(id: Int) async throws -> [ModuleEpisodeMetadata] {
+        try await prepare()
+        let result: [ModuleEpisodeMetadata] = try await runner.readMetadata("extractEpisodeMetadata", args: [id])
+        guard result.allSatisfy({ $0.id > 0 && $0.subjectId == id && $0.number.isFinite && $0.number > 0 }) else {
+            throw ProviderError.notFound
+        }
+        return result.sorted { $0.number < $1.number }
+    }
+
+    func browse(_ catalog: ModuleMetadataCatalog, page: Int = 1) async throws -> [Media] {
+        try await prepare()
+        let result: [ModuleMetadata] = try await runner.readMetadata("browseMetadata", args: [catalog.rawValue, page])
+        return try validated(result).map { $0.media(moduleID: module.id) }
+    }
+
+    private func validated(_ records: [ModuleMetadata]) throws -> [ModuleMetadata] {
+        guard records.allSatisfy(\.isValid) else { throw ProviderError.unsupported }
+        var seen = Set<String>()
+        return records.filter { seen.insert("\($0.source):\($0.id)").inserted }
+    }
+}
diff --git a/Shirox/Views/MetadataCatalogView.swift b/Shirox/Views/MetadataCatalogView.swift
new file mode 100644
--- /dev/null
+++ b/Shirox/Views/MetadataCatalogView.swift
@@ -0,0 +1,71 @@
+import SwiftUI
+
+@MainActor
+struct MetadataCatalogView: View {
+    let catalog: ModuleMetadataCatalog
+    @ObservedObject private var discovery = DiscoverySource.shared
+    @State private var items: [Media] = []
+    @State private var page = 1
+    @State private var loading = false
+    @State private var reachedEnd = false
+    @State private var error: String?
+    @State private var generation = UUID()
+
+    private var columns: [GridItem] {
+        #if os(macOS)
+        PosterGrid.columns
+        #else
+        [GridItem(.adaptive(minimum: 140, maximum: 220), spacing: 12)]
+        #endif
+    }
+
+    var body: some View {
+        ScrollView {
+            LazyVStack {
+                if let error { Text(error).foregroundStyle(.red).padding() }
+                if !loading && items.isEmpty && error == nil { Text("modules.metadata_empty").padding() }
+                LazyVGrid(columns: columns, spacing: 12) {
+                    ForEach(items) { media in
+                        NavigationLink { MediaDestination(media: media) } label: { AniListCardView(media: media) }
+                            .buttonStyle(CardPressStyle())
+                            .onAppear {
+                                if media.id == items.last?.id && !reachedEnd && !loading {
+                                    Task { await load(generation: generation) }
+                                }
+                            }
+                    }
+                }
+                if loading { ProgressView().padding() }
+            }
+            .padding(16)
+        }
+        .navigationTitle(catalog.title)
+        .task(id: discovery.sourceID) {
+            let request = UUID()
+            generation = request
+            items = []
+            page = 1
+            reachedEnd = false
+            loading = false
+            await load(generation: request)
+        }
+    }
+
+    private func load(generation request: UUID) async {
+        guard !loading, !reachedEnd, let module = discovery.metadataModule else { return }
+        loading = true
+        error = nil
+        defer { if generation == request { loading = false } }
+        do {
+            let result = try await ModuleMetadataService(module: module).browse(catalog, page: page)
+            guard !Task.isCancelled, generation == request else { return }
+            let known = Set(items.map(\.uniqueId))
+            let fresh = result.filter { !known.contains($0.uniqueId) }
+            reachedEnd = result.isEmpty || fresh.isEmpty
+            items.append(contentsOf: fresh)
+            page += 1
+        } catch {
+            if !Task.isCancelled && generation == request { self.error = error.localizedDescription }
+        }
+    }
+}
