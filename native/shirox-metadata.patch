+    nonisolated static func episode(_ row: BangumiEpisode, subjectID: Int) -> ModuleEpisodeMetadata? {
+        guard row.id > 0, let number = row.sort, number.isFinite, number > 0 else { return nil }
+        let display = number.truncatingRemainder(dividingBy: 1) == 0 ? String(Int(number)) : String(number)
+        return ModuleEpisodeMetadata(
+            id: row.id, subjectId: subjectID, number: number,
+            episodeNumber: row.ep.flatMap { $0.isFinite && $0 > 0 ? $0 : nil },
+            title: clean(row.nameCN) ?? clean(row.name) ?? "#\(display)",
+            originalTitle: clean(row.name),
+            description: clean(row.desc) ?? "",
+            airdate: date(row.airdate),
+            duration: clean(row.duration),
+            durationSeconds: positive(row.durationSeconds),
+            url: "\(siteBase)/ep/\(row.id)")
+    }
+
+    private nonisolated static func aliases(_ item: BangumiSubject) -> [String] {
+        var names: [String] = []
+        for name in [clean(item.name), clean(item.nameCN)] + infobox(item, key: "别名").map(Optional.some) {
+            if let name, !names.contains(name) { names.append(name) }
+        }
+        return names
+    }
+
+    private nonisolated static func infobox(_ item: BangumiSubject, key: String) -> [String] {
+        var values: [String] = []
+        for field in item.infobox ?? [] where field.key == key {
+            for value in field.values {
+                if let value = clean(value), !values.contains(value) { values.append(value) }
+            }
+        }
+        return values
+    }
+
+    private nonisolated static func unique(_ records: [ModuleMetadata]) -> [ModuleMetadata] {
+        var seen = Set<Int>()
+        return records.filter { seen.insert($0.id).inserted }
+    }
+
+    private nonisolated static func clean(_ value: String?) -> String? {
+        guard let value = value?.trimmingCharacters(in: .whitespacesAndNewlines), !value.isEmpty else { return nil }
+        return value
+    }
+
+    private nonisolated static func positive(_ value: Int?) -> Int? {
+        guard let value, value > 0 else { return nil }
+        return value
+    }
+
+    /// `YYYY-MM-DD` only; Bangumi uses free text for some unknown dates.
+    private nonisolated static func date(_ value: String?) -> String? {
+        guard let value = clean(value), value.count == 10,
+              value.range(of: #"^\d{4}-\d{2}-\d{2}$"#, options: .regularExpression) != nil else { return nil }
+        return value
+    }
+
+    // MARK: - Transport
+
+    private func request<T: Decodable>(_ path: String, query: [String: String] = [:],
+                                       method: String = "GET", body: Data? = nil) async throws -> T {
+        var components = URLComponents(string: Self.apiBase + path)
+        if !query.isEmpty {
+            components?.queryItems = query.keys.sorted().map { URLQueryItem(name: $0, value: query[$0]) }
+        }
+        guard let url = components?.url else { throw URLError(.badURL) }
+        var request = URLRequest(url: url, timeoutInterval: 30)
+        request.httpMethod = method
+        request.setValue("application/json", forHTTPHeaderField: "Accept")
+        request.setValue(Self.userAgent, forHTTPHeaderField: "User-Agent")
+        if let body {
+            request.httpBody = body
+            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
+        }
+        let (data, response) = try await session.data(for: request)
+        guard let http = response as? HTTPURLResponse else { throw URLError(.badServerResponse) }
+        switch http.statusCode {
+        case 200..<300: break
+        case 404: throw ProviderError.notFound
+        default: throw ProviderError.serverError(http.statusCode)
+        }
+        do {
+            return try JSONDecoder().decode(T.self, from: data)
+        } catch {
+            Logger.shared.log("[Bangumi] Could not decode \(path): \(error)", type: "Provider")
+            throw ProviderError.decodingError(error)
+        }
+    }
+}
