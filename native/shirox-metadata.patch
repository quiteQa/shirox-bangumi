+            schemaVersion: 1, source: "bangumi", id: item.id, url: "\(siteBase)/subject/\(item.id)",
+            title: chinese ?? original ?? "Bangumi #\(item.id)",
+            titles: .init(chinese: chinese, original: original),
+            aliases: aliases(item),
+            description: clean(item.summary) ?? clean(item.shortSummary) ?? "",
+            poster: poster,
+            format: clean(item.platform),
+            releaseDate: releaseDate,
+            year: releaseDate.flatMap { Int($0.prefix(4)) },
+            episodeCount: positive(item.eps),
+            totalEpisodes: positive(item.totalEpisodes),
+            tags: tags,
+            studios: infobox(item, key: "动画制作"),
+            directors: infobox(item, key: "导演"),
+            rating: .init(score: score, scale: 10, rank: positive(item.rating?.rank ?? item.rank),
