new file mode 100644
index 0000000..9a330cd
--- /dev/null
+++ b/Shirox/Services/ModuleMetadataService.swift
@@ -0,0 +1,95 @@
+import Foundation
+
+/// Bangumi is built into the app natively (`BangumiService`), not run as a module.
+enum BuiltInMetadataModules {
+    /// The imported Bangumi module's identity. Copies installed before Bangumi was built in are
+    /// hidden, never run, and choosing one selects the built-in source instead.
+    static let bangumiID = "https://raw.githubusercontent.com/quiteQa/shirox-bangumi/main/bangumi.js"
+}
+
+/// Where Home and Search read metadata from when a metadata source is chosen.
+@MainActor
+enum MetadataSource {
+    case bangumi
+    case module(ModuleDefinition)
+
+    var name: String {
+        switch self {
+        case .bangumi: return ProviderType.bangumi.displayName
+        case .module(let module): return module.sourceName
+        }
+    }
+
+    func search(_ keyword: String) async throws -> [Media] {
+        switch self {
+        case .bangumi:
+            return try await BangumiService.shared.search(keyword).map(BangumiService.media)
+        case .module(let module):
+            return try await ModuleMetadataService(module: module).search(keyword).map { $0.media(moduleID: module.id) }
+        }
+    }
+
+    func browse(_ catalog: ModuleMetadataCatalog, page: Int = 1) async throws -> [Media] {
+        switch self {
+        case .bangumi:
+            return try await BangumiService.shared.browse(catalog, page: page).map(BangumiService.media)
+        case .module(let module):
+            return try await ModuleMetadataService(module: module).browse(catalog, page: page)
+        }
+    }
+}
+
+/// A separate runner prevents reading metadata from replacing the playback module's JS.
+@MainActor
+final class ModuleMetadataService {
+    private let module: ModuleDefinition
+    private let runner = ModuleJSRunner()
+    private var loaded = false
+
+    init(module: ModuleDefinition) {
+        self.module = module
+    }
+
+    private func prepare() async throws {
+        // The legacy Bangumi module is never run: Bangumi is read natively.
+        guard module.isMetadata, module.id != BuiltInMetadataModules.bangumiID else { throw ProviderError.unsupported }
+        if !loaded {
+            try await runner.load(module: module)
+            loaded = true
+        }
+    }
+
+    func search(_ keyword: String) async throws -> [ModuleMetadata] {
+        try await prepare()
+        let result: [ModuleMetadata] = try await runner.readMetadata("searchMetadata", args: [keyword])
+        return try validated(result)
+    }
+
+    func detail(id: Int) async throws -> ModuleMetadata {
+        try await prepare()
+        let result: ModuleMetadata = try await runner.readMetadata("extractMetadata", args: [id])
+        guard result.isValid, result.id == id else { throw ProviderError.notFound }
+        return result
+    }
+
+    func episodes(id: Int) async throws -> [ModuleEpisodeMetadata] {
+        try await prepare()
+        let result: [ModuleEpisodeMetadata] = try await runner.readMetadata("extractEpisodeMetadata", args: [id])
+        guard result.allSatisfy({ $0.id > 0 && $0.subjectId == id && $0.number.isFinite && $0.number > 0 }) else {
+            throw ProviderError.notFound
+        }
+        return result.sorted { $0.number < $1.number }
+    }
+
+    func browse(_ catalog: ModuleMetadataCatalog, page: Int = 1) async throws -> [Media] {
+        try await prepare()
+        let result: [ModuleMetadata] = try await runner.readMetadata("browseMetadata", args: [catalog.rawValue, page])
+        return try validated(result).map { $0.media(moduleID: module.id) }
+    }
+
+    private func validated(_ records: [ModuleMetadata]) throws -> [ModuleMetadata] {
+        guard records.allSatisfy(\.isValid) else { throw ProviderError.unsupported }
+        var seen = Set<String>()
+        return records.filter { seen.insert("\($0.source):\($0.id)").inserted }
+    }
+}
