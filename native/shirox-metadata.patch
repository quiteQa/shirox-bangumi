+        }).filter(function (tag, i, all) { return tag && all.indexOf(tag) === i; });
+        return {
+            schemaVersion: 1,
+            source: 'bangumi',
+            id: id,
+            url: SITE + '/subject/' + id,
+            detailLevel: detailLevel,
