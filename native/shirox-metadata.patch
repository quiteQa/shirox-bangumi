+        platform = try? c.decodeIfPresent(String.self, forKey: .platform)
+        images = try? c.decodeIfPresent(Images.self, forKey: .images)
+        image = try? c.decodeIfPresent(String.self, forKey: .image)
+        infobox = (try? c.decodeIfPresent([BangumiLenient<BangumiInfoboxField>].self, forKey: .infobox))?.compactMap(\.value)
+        rating = try? c.decodeIfPresent(BangumiRating.self, forKey: .rating)
+        score = try? c.decodeIfPresent(Double.self, forKey: .score)
+        rank = try? c.decodeIfPresent(Int.self, forKey: .rank)
+        eps = try? c.decodeIfPresent(Int.self, forKey: .eps)
+        totalEpisodes = try? c.decodeIfPresent(Int.self, forKey: .totalEpisodes)
+        tags = (try? c.decodeIfPresent([BangumiLenient<Tag>].self, forKey: .tags))?.compactMap(\.value)
+    }
+}
+
+struct BangumiRating: Decodable {
+    let rank: Int?
+    let total: Int?
+    let score: Double?
+
+    private enum CodingKeys: String, CodingKey { case rank, total, score }
+    init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        rank = try? c.decodeIfPresent(Int.self, forKey: .rank)
+        total = try? c.decodeIfPresent(Int.self, forKey: .total)
+        score = try? c.decodeIfPresent(Double.self, forKey: .score)
+    }
+}
+
+/// An infobox value is either a string or a list of `{k?, v}` entries.
+struct BangumiInfoboxField: Decodable {
+    let key: String
+    let values: [String]
+
+    private struct Entry: Decodable { let v: String? }
+    private enum CodingKeys: String, CodingKey { case key, value }
+
+    init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        key = (try? c.decode(String.self, forKey: .key)) ?? ""
+        if let text = try? c.decode(String.self, forKey: .value) {
+            values = [text]
+        } else if let entries = try? c.decode([BangumiLenient<BangumiInfoboxEntry>].self, forKey: .value) {
+            values = entries.compactMap { $0.value?.v }
+        } else {
+            values = []
+        }
+    }
+}
