+    init(from decoder: Decoder) throws {
+        let c = try decoder.container(keyedBy: CodingKeys.self)
+        data = try c.decode([BangumiLenient<Item>].self, forKey: .data).compactMap(\.value)
+        total = try? c.decodeIfPresent(Int.self, forKey: .total)
+    }
+}
+
+/// One malformed row is dropped rather than failing the whole page.
+struct BangumiLenient<Value: Decodable>: Decodable {
+    let value: Value?
+    init(from decoder: Decoder) throws { value = try? Value(from: decoder) }
+}
