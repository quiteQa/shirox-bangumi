diff --git a/ShiroxTests/MetadataModuleTests.swift b/ShiroxTests/MetadataModuleTests.swift
new file mode 100644
index 0000000..af4876c
--- /dev/null
+++ b/ShiroxTests/MetadataModuleTests.swift
@@ -0,0 +1,201 @@
+import XCTest
+@testable import Shirox
+
+@MainActor
+final class MetadataModuleTests: XCTestCase {
+    private var fixture: String {
+        """
+        {"schemaVersion":1,"source":"bangumi","id":400602,"url":"https://bgm.tv/subject/400602",
+         "title":"Frieren","titles":{"chinese":"Frieren","original":"Sousou no Frieren"},
+         "aliases":["Frieren"],"description":"Synopsis","poster":"https://example.com/cover.jpg",
+         "format":"TV","releaseDate":"2023-09-29","year":2023,"episodeCount":28,"totalEpisodes":28,
+         "tags":["Fantasy"],"studios":["MADHOUSE"],"directors":[],
+         "rating":{"score":8.5,"scale":10,"rank":43,"votes":100}}
+        """
+    }
+
+    private func module(type: String = "metadata") throws -> ModuleDefinition {
+        try JSONDecoder().decode(ModuleDefinition.self, from: Data("""
+        {"sourceName":"Metadata","version":"0.3.0","scriptUrl":"https://example.com/metadata.js","type":"\(type)"}
+        """.utf8))
+    }
+
+    private let subjectJSON = """
+    {"id":400602,"type":2,"name":"葬送のフリーレン","name_cn":"葬送的芙莉莲","summary":" Synopsis ",
+     "nsfw":false,"date":"2023-09-29","platform":"TV",
+     "images":{"large":"https://lain.bgm.tv/pic/cover/l/x.jpg","common":"c","medium":"m","small":"s","grid":"g"},
+     "infobox":[{"key":"别名","value":[{"v":"Frieren"},{"k":"en","v":"Frieren: Beyond Journey's End"}]},
+                {"key":"动画制作","value":"MADHOUSE"},{"key":"导演","value":"斋藤圭一郎"},{"key":"其他","value":7}],
+     "rating":{"rank":1,"total":50000,"count":{"10":1},"score":9.1},
+     "eps":28,"total_episodes":28,"tags":[{"name":"奇幻","count":1},{"name":"奇幻","count":1},{"name":"2023年10月"}]}
+    """
+
+    func testBangumiSubjectBecomesBuiltInMediaWithItsOwnIDs() throws {
+        let subject = try JSONDecoder().decode(BangumiSubject.self, from: Data(subjectJSON.utf8))
+        XCTAssertTrue(subject.isAnime)
+        let record = try XCTUnwrap(BangumiService.metadata(subject))
+        XCTAssertTrue(record.isValid)
+        XCTAssertEqual(record.title, "葬送的芙莉莲")
+        XCTAssertEqual(record.titles.original, "葬送のフリーレン")
+        XCTAssertEqual(record.description, "Synopsis")
+        XCTAssertEqual(record.poster, "https://lain.bgm.tv/pic/cover/l/x.jpg")
+        XCTAssertEqual(record.year, 2023)
+        XCTAssertEqual(record.aliases, ["葬送のフリーレン", "葬送的芙莉莲", "Frieren", "Frieren: Beyond Journey's End"])
+        XCTAssertEqual(record.studios, ["MADHOUSE"])
+        XCTAssertEqual(record.directors, ["斋藤圭一郎"])
+        XCTAssertEqual(record.tags, ["奇幻", "2023年10月"])
+        XCTAssertEqual(record.rating.rank, 1)
+        XCTAssertEqual(record.rating.votes, 50000)
+
+        let media = BangumiService.media(record)
+        XCTAssertEqual(media.provider, .bangumi)
+        XCTAssertEqual(media.id, 400602)
+        XCTAssertEqual(media.uniqueId, "bangumi-400602")
+        XCTAssertNil(media.idMal, "Bangumi ids are never sent to a tracker")
+        XCTAssertEqual(media.averageScore, 91)
+        XCTAssertFalse(media.usesTVDBArtwork)
+        XCTAssertEqual(MediaDestination.target(for: media), .bangumi(subjectID: 400602))
+        XCTAssertEqual(try JSONDecoder().decode(Media.self, from: JSONEncoder().encode(media)).provider, .bangumi)
+    }
+
+    func testBangumiSkipsAdultAndNonAnimeSubjects() throws {
+        let adult = subjectJSON.replacingOccurrences(of: "\"nsfw\":false", with: "\"nsfw\":true")
+        XCTAssertFalse(try JSONDecoder().decode(BangumiSubject.self, from: Data(adult.utf8)).isAnime)
+        let book = subjectJSON.replacingOccurrences(of: "\"type\":2", with: "\"type\":1")
+        XCTAssertFalse(try JSONDecoder().decode(BangumiSubject.self, from: Data(book.utf8)).isAnime)
+    }
+
+    func testBangumiPageDropsMalformedRows() throws {
+        let json = "{\"total\":2,\"data\":[\(subjectJSON),{\"name\":\"no id\"}]}"
+        let page = try JSONDecoder().decode(BangumiPage<BangumiSubject>.self, from: Data(json.utf8))
+        XCTAssertEqual(page.data.map(\.id), [400602])
+        XCTAssertEqual(page.total, 2)
+    }
+
+    func testBangumiEpisodesKeepBroadcastNumbers() throws {
+        let json = """
+        {"id":1227187,"type":0,"name":"冒険の終わり","name_cn":"冒险的结束","sort":1,"ep":1,
+         "airdate":"2023-09-29","duration":"00:24:00","duration_seconds":1440,"desc":"","subject_id":400602}
+        """
+        let row = try JSONDecoder().decode(BangumiEpisode.self, from: Data(json.utf8))
+        let episode = try XCTUnwrap(BangumiService.episode(row, subjectID: 400602))
+        XCTAssertEqual(episode.number, 1)
+        XCTAssertEqual(episode.title, "冒险的结束")
+        XCTAssertEqual(episode.originalTitle, "冒険の終わり")
+        XCTAssertEqual(episode.airdate, "2023-09-29")
+        XCTAssertEqual(episode.durationSeconds, 1440)
+        XCTAssertEqual(episode.url, "https://bgm.tv/ep/1227187")
+    }
+
+    func testBangumiSubjectLinksAreRecognised() {
+        XCTAssertEqual(BangumiService.subjectID(in: "https://bgm.tv/subject/400602"), 400602)
+        XCTAssertEqual(BangumiService.subjectID(in: "https://bangumi.tv/subject/400602/"), 400602)
+        XCTAssertEqual(BangumiService.subjectID(in: "bgm:400602"), 400602)
+        XCTAssertNil(BangumiService.subjectID(in: "400602 Frieren"))
+        XCTAssertNil(BangumiService.subjectID(in: "https://example.com/subject/400602"))
+    }
+
+    func testLegacyBangumiModuleIsNeitherRunNorAPlaybackSource() async throws {
+        let legacy = try JSONDecoder().decode(ModuleDefinition.self, from: Data("""
+        {"sourceName":"Old Bangumi","version":"0.2.0","scriptUrl":"\(BuiltInMetadataModules.bangumiID)","type":"anime"}
+        """.utf8))
+        XCTAssertTrue(legacy.isMetadata)
+        XCTAssertFalse(legacy.isAnimePlayback)
+        do {
+            _ = try await ModuleMetadataService(module: legacy).search("Frieren")
+            XCTFail("the legacy Bangumi script must not run")
+        } catch {
+            XCTAssertTrue(error is ProviderError)
+        }
+    }
+
+    func testChosenLegacyBangumiModuleMovesToBuiltInBangumi() throws {
+        let suite = "metadata-builtin-\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        defaults.set("metadata", forKey: DiscoverySource.choiceKey)
+        defaults.set(BuiltInMetadataModules.bangumiID, forKey: DiscoverySource.metadataKey)
+        let source = DiscoverySource(defaults: defaults, selectProvider: { _ in })
+        XCTAssertTrue(source.usesBangumi)
+        XCTAssertTrue(source.usesMetadata)
+        XCTAssertEqual(source.sourceID, "bangumi")
+        XCTAssertEqual(source.metadataSource?.name, "Bangumi")
+        XCTAssertEqual(defaults.string(forKey: DiscoverySource.choiceKey), "bangumi")
+        XCTAssertNil(defaults.string(forKey: DiscoverySource.metadataKey))
+    }
+
+    func testBangumiChoiceSurvivesProfileReload() throws {
+        let suite = "metadata-builtin-\(UUID().uuidString)"
+        let defaults = try XCTUnwrap(UserDefaults(suiteName: suite))
+        defer { defaults.removePersistentDomain(forName: suite) }
+        let source = DiscoverySource(defaults: defaults, selectProvider: { _ in })
+        source.chooseBangumi()
+        XCTAssertTrue(source.usesBangumi)
+        source.chooseProvider(.anilist)
+        source.reloadForProfileSwitch()
+        XCTAssertFalse(source.usesBangumi)
+        XCTAssertFalse(source.usesMetadata)
+        defaults.set("bangumi", forKey: DiscoverySource.choiceKey)
+        source.reloadForProfileSwitch()
+        XCTAssertTrue(source.usesBangumi)
+        XCTAssertEqual(source.sourceID, "bangumi")
+    }
+
+    func testMetadataIsNotAMangaOrPlaybackModule() throws {
+        let metadata = try module()
+        XCTAssertTrue(metadata.isMetadata)
+        XCTAssertFalse(metadata.isManga)
+        XCTAssertFalse(metadata.isAnimePlayback)
+        let video = try module(type: "anime")
+        XCTAssertEqual(AnimeModulePreference.pick(active: metadata, modules: [metadata, video]), video)
+        XCTAssertNil(AnimeModulePreference.pick(active: metadata, modules: [metadata]))
+    }
+
+    func testMetadataIDsAreNamespacedAndScoresUseTheNativeScale() throws {
+        let record = try JSONDecoder().decode(ModuleMetadata.self, from: Data(fixture.utf8))
+        let media = record.media(moduleID: "first")
+        XCTAssertEqual(media.averageScore, 85)
+        XCTAssertEqual(media.provider, .local)
+        XCTAssertNil(media.idMal)
+        XCTAssertNil(media.title.romaji)
+        XCTAssertEqual(media.title.native, record.titles.original)
+        XCTAssertNil(media.genres, "community tags are not native genre names")
+        XCTAssertFalse(media.usesTVDBArtwork)
+        XCTAssertNotEqual(media.id, record.id, "Bangumi ids must not be used as AniList ids")
+        XCTAssertNotEqual(media.uniqueId, record.media(moduleID: "second").uniqueId)
+        let identity = ModuleMetadataIdentity(moduleID: "first", source: "bangumi", subjectID: 400602)
+        XCTAssertEqual(media.moduleMetadata, identity)
+        XCTAssertEqual(MediaDestination.target(for: media), .metadata(identity))
+        XCTAssertEqual(try JSONDecoder().decode(Media.self, from: JSONEncoder().encode(media)).moduleMetadata, identity)
+    }
+
+    func testInvalidRatingScaleIsNotShownAsAValidNativeScore() throws {
+        let json = fixture.replacingOccurrences(of: "\"scale\":10", with: "\"scale\":100")
+        let record = try JSONDecoder().decode(ModuleMetadata.self, from: Data(json.utf8))
+        XCTAssertFalse(record.isValid)
+        XCTAssertNil(record.rating.scoreOutOf100)
+    }
+
+    func testMetadataCheckDoesNotCallTheStreamFunction() async throws {
+        var definition = try module()
+        let object = try JSONSerialization.jsonObject(with: Data(fixture.utf8))
+        let json = String(decoding: try JSONSerialization.data(withJSONObject: object), as: UTF8.self)
+        let quoted = String(decoding: try JSONSerialization.data(withJSONObject: json, options: .fragmentsAllowed), as: UTF8.self)
+        definition.scriptContent = """
+        async function searchMetadata(q) { return '[' + \(quoted) + ']' }
+        async function extractMetadata(id) { return \(quoted) }
+        async function extractStreamUrl() { throw new Error('metadata check tried playback') }
+        """
+        let result = await ModuleCheck.check(definition)
+        XCTAssertEqual(result, .passed)
+    }
+
+    func testPlaybackRunnerRefusesMetadata() async throws {
+        do {
+            try await JSEngine.shared.loadModule(module())
+            XCTFail("metadata must not replace the playback context")
+        } catch {
+            XCTAssertTrue(error is ProviderError)
+        }
+    }
+}
